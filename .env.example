# Settings for email/tools/send-test.py. Copy this file to .env (git ignores .env; this example
# is committed, so never put a real password here), fill it in, then run: chmod 600 .env
# The Google account that sends the test, and its app password (myaccount.google.com/apppasswords).
LIFEPOINTE_SMTP_FROM=you@gmail.com
LIFEPOINTE_SMTP_PASSWORD=
